
# ==========================================
# NEBULA - CONFIGURACAO DO AMBIENTE
# ==========================================

# Banco de dados PostgreSQL
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/nebula?schema=public"

# Autenticacao Auth.js
# Gere uma chave segura com: npx auth secret
AUTH_SECRET="SUBSTITUA_POR_UMA_CHAVE_SECRETA"

# Ollama - geracao de texto e memoria
OLLAMA_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"

# ComfyUI - geracao de imagens
COMFYUI_URL="http://127.0.0.1:8188"
